rm(list=ls())

library(ggdag)
library(ggplot2)

dag1<-dagitty::dagitty("dag {

x<-u->y
x->y

x [education]
y [treatment]

}")

tidy_dag1<-tidy_dagitty(dag1)
tidy_dag1

ggdag(tidy_dag1) + theme_dag()

dag2<-dagitty::dagitty("dag {

z->x->y
x<-u->y
x->y

x [education]
y [treatment]

}")
coordinates(dag2)<-list(x=c(z=1,x=2,u=3,y=4),y=c(z=0,x=0,u=1,y=0))
tidy_dag2<-tidy_dagitty(dag2)
tidy_dag2

ggdag(tidy_dag2, use_labels = ) + theme_dag()

dag3<-dagify(y ~ x, y ~ u, x ~ u,exposure="x",outcome="y",
             labels=c(y="Wages",x="Education",u="ability"),
             coords=list(x=c(x=1,u=2,y=3),
                         y=c(x=0,u=1,y=0)))
ggdag_status(dag3,use_labels = "label")+theme_dag()

